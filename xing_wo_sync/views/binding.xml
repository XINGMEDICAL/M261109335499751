<odoo>
  <record id="binding_list" model="ir.ui.view">
    <field name="name">xing.wo.binding.list</field>
    <field name="model">xing.wo.binding</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="company_id"/><field name="source_key"/><field name="kind"/>
        <field name="source_id"/><field name="target_ref"/>
      </list>
    </field>
  </record>
  <record id="bindings_action" model="ir.actions.act_window">
    <field name="name">Vinculos World Office</field>
    <field name="res_model">xing.wo.binding</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="sync_root_menu" name="World Office" groups="base.group_system" sequence="90"/>
  <menuitem id="sync_bindings_menu" name="Vinculos de sincronizacion" parent="sync_root_menu" action="bindings_action"/>
</odoo>
