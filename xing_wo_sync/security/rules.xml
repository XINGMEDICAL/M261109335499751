<odoo>
  <!-- Odoo 20: permisos y restricciones usan el modelo unico ir.access. -->
  <record id="access_xing_wo_binding_admin" model="ir.access">
    <field name="name">World Office: administradores, lectura y creacion</field>
    <field name="model_id" ref="model_xing_wo_binding"/>
    <field name="group_id" ref="base.group_system"/>
    <field name="operation">cr</field>
  </record>
  <record id="binding_company_rule" model="ir.access">
    <field name="name">World Office: empresas permitidas</field>
    <field name="model_id" ref="model_xing_wo_binding"/>
    <!-- Sin grupo: restriccion global, combinada con el permiso anterior. -->
    <field name="operation">crud</field>
    <field name="domain">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
